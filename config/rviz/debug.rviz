Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Class: rviz_default_plugins/Pose
      Enabled: true
      Name: EgoPose
      Shape: Axes
      Topic:
        Value: /rl_debug/ego_pose
        Depth: 10
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: Waypoints
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Value: /rl_debug/waypoints
        Depth: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Vehicles
      Namespaces:
        {}
      Topic:
        Value: /rl_debug/vehicles
        Depth: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: FOV
      Topic:
        Value: /rl_debug/fov
        Depth: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: TrafficLight
      Topic:
        Value: /rl_debug/traffic
        Depth: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: ego
      Value: Orbit (rviz_default_plugins)
      Yaw: 0
Window Geometry:
  Height: 846
  Width: 1200
